// Tailnet policy for the homelab remote-access setup (applied 2026-09-18, tag:cloud added the same day).
// Mirror of what is live in the Tailscale admin console; apply with
//   curl -u "<api token>:" -H 'Content-Type: application/hujson' \
//     --data-binary @docs/tailscale-policy.hujson https://api.tailscale.com/api/v2/tailnet/-/acl
// (Claude's OAuth client is read-only for the policy on purpose; a human applies this.)
// Design: docs/superpowers/specs/2026-09-18-remote-access-tailscale-design.md
{
	// One tag for both subnet routers (homelab-k8s pod, homelab-nas container).
	"tagOwners": {
		"tag:subnet-router": ["autogroup:admin"],
		// Cloud VMs (supabase). Tagged nodes are not autogroup:member, so they
		// get no source access to the LAN through the routers.
		"tag:cloud": ["autogroup:admin"],
	},

	// Routers carrying the tag get the LAN route enabled without a manual click
	// in the admin console, so the in-cluster router survives redeploys.
	"autoApprovers": {
		"routes": {
			"192.168.50.0/24": ["tag:subnet-router"],
		},
	},

	"grants": [
		// Philip's own devices reach everything: other devices, the routers and
		// the whole home LAN through them. The tagged routers get no source
		// access of their own (they only forward).
		{"src": ["autogroup:member"], "dst": ["*"], "ip": ["*"]},
	],

	// Legacy "acls" block on purpose: autogroup:shared is only accepted here,
	// not in "grants" (the editor rejects it there with "unknown user or host").
	// Friends the "minecraft" node has been SHARED with (2026-09-19). Sharing
	// already limits them to that one machine; this limits them to the game
	// port on it. They never see the LAN or the routers.
	"acls": [
		{"action": "accept", "src": ["autogroup:shared"], "dst": ["*:25565"]},
	],

	"ssh": [
		// Tailscale SSH into one's own devices, with re-auth (check mode).
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	"tests": [
		{
			"src":    "philiprutberg00@gmail.com",
			"accept": ["192.168.50.20:6443", "192.168.50.254:9443", "192.168.50.254:22", "192.168.50.10:50000"],
		},
		{
			"src":  "tag:subnet-router",
			"deny": ["192.168.50.254:9443"],
		},
		{
			"src":  "tag:cloud",
			"deny": ["192.168.50.254:9443", "192.168.50.20:6443"],
		},
		// (No test for autogroup:shared: the tests section does not accept it as a src.)
	],
}
